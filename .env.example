AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=paste_your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-flash
PORT=4173

# 可选：deepseek-flash 的思维链也占用 max_tokens，额度太小会导致返回空内容（默认 8000，最低 2000）。
# 如果孩子一次输入很多任务被提示"输入内容较多"，可以调大这个值。
# DEEPSEEK_MAX_TOKENS=8000
# 可选：思维深度 low / high / max，默认 low（更快，识别任务足够用）。
# AI_REASONING_EFFORT=low

# 如需使用 OpenAI，请改为 AI_PROVIDER=openai 并设置：
# OPENAI_API_KEY=paste_your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini
