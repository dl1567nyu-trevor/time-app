AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=paste_your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-flash
PORT=4173

# ---- DeepSeek 速度相关（默认值就是实测最快的组合）----
# 思考模式默认是"开启"的，reasoning_effort 只调深度、不等于关闭。本任务不需要多步推理，
# 代码默认关掉思考：实测同一句话输出 token 从 1558 降到 95，整条链路从 5.8 秒降到 1 秒，
# 长输入也不会再出现"思考吃光 max_tokens 导致 JSON 为空"。想恢复思考就设为 enabled。
# DEEPSEEK_THINKING=disabled
# 仅在思考模式开启时才有意义，取值 low / high / max（默认 low）。
# AI_REASONING_EFFORT=low
# 输出 token 上限，默认 20000：关掉思考后实际只需要 200 上下，留大是防超长输入被截断。
# DEEPSEEK_MAX_TOKENS=20000

# 如需使用 OpenAI，请改为 AI_PROVIDER=openai 并设置：
# OPENAI_API_KEY=paste_your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# ---- 本地模型（推荐给孩子用：输入不出这台电脑）----
# 1) 用 tools\start-local-ai.ps1 启动 llama.cpp 本地服务
# 2) 把上面一行改成 AI_PROVIDER=local
# AI_PROVIDER=local
# LOCAL_AI_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_AI_MODEL=Qwen3-4B-Q4_K_M
# 本机推理比云端慢，默认给 120 秒；模型首次加载后每次识别大约几秒。
# LOCAL_AI_TIMEOUT_MS=120000
# 输出 JSON 的 token 上限；任务很多导致结果被截断时可以调大。
# LOCAL_AI_MAX_TOKENS=1024
